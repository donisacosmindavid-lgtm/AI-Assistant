# Model pentru fisierul .env. Aici NU se pun valori reale.
# Valorile reale se lipesc in .env (care nu urca pe GitHub).

# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numarul Twilio de pe care se suna (format international, cu + si fara spatii)
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Mobilul meu, pe care suna Jarvis (format international, cu + si fara spatii)
MY_PHONE_NUMBER=+407xxxxxxxx

# Claude API (clasificarea emailurilor). Claude Console -> API keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
